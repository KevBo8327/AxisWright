    <!-- Hinweise zum aktiven Werkzeug -->
    <string name="ws_hint_select">Tippe Elemente an oder ziehe ein Rechteck auf. Ziehen verschiebt – die Bedingungen bleiben erhalten.</string>
    <string name="ws_hint_line">Linie: Punkte nacheinander antippen (Stift: ziehen). „Fertig“ oder Esc beendet den Linienzug.</string>
    <string name="ws_hint_line_tangent">Tangente: Anfang und Ende antippen – ein Ende auf einem Kreis oder Bogen (oder beide: Tangente zwischen zwei Kreisen).</string>
    <string name="ws_hint_rect_corners">Rechteck: zwei gegenüberliegende Ecken antippen oder aufziehen.</string>
    <string name="ws_hint_rect_center_first">Rechteck: zuerst den Mittelpunkt antippen (z. B. den Ursprung).</string>
    <string name="ws_hint_rect_center_corner">Rechteck: jetzt eine Ecke – die Form bleibt mittig.</string>
    <string name="ws_hint_rect_three_start">Rechteck: Anfang einer Kante antippen.</string>
    <string name="ws_hint_rect_three_end">Rechteck: Ende der Kante – auch schräg.</string>
    <string name="ws_hint_rect_three_height">Rechteck: jetzt die Höhe antippen.</string>
    <string name="ws_hint_circle_center">Kreis: Mittelpunkt, dann einen Punkt auf dem Kreis.</string>
    <string name="ws_hint_circle_two_points">Kreis: zwei gegenüberliegende Punkte antippen (Durchmesser).</string>
    <string name="ws_hint_circle_three_points">Kreis: drei Punkte auf dem Kreis antippen (%1$d von 3).</string>
    <string name="ws_hint_circle_tangent2_pick">Kreis: zwei Linien, Kreise oder Bögen antippen, die er berühren soll (%1$d von 2).</string>
    <string name="ws_hint_circle_tangent2_place">Kreis: jetzt die Lage antippen – sie bestimmt die Größe.</string>
    <string name="ws_hint_circle_tangent3">Kreis: drei Linien, Kreise oder Bögen antippen, die er berühren soll (%1$d von 3) – nahe der Berührstelle.</string>
    <string name="ws_hint_slot_first">Langloch: Mittelpunkt der ersten Rundung antippen.</string>
    <string name="ws_hint_slot_second">Langloch: Mittelpunkt der zweiten Rundung.</string>
    <string name="ws_hint_slot_width">Langloch: jetzt die Breite antippen.</string>
    <string name="ws_hint_polygon_center">Vieleck: Mittelpunkt antippen.</string>
    <string name="ws_hint_polygon_inscribed_corner">Vieleck: eine Ecke antippen (Größe und Drehung).</string>
    <string name="ws_hint_polygon_circumscribed_side">Vieleck: eine Seitenmitte antippen – der Kreisdurchmesser ist die Schlüsselweite.</string>
    <string name="ws_hint_arc_center">Bogen: Mittelpunkt, Startpunkt, dann die Richtung des Endes (gegen den Uhrzeigersinn).</string>
    <string name="ws_hint_arc_three_start">Bogen: Startpunkt antippen.</string>
    <string name="ws_hint_arc_three_end">Bogen: Endpunkt antippen.</string>
    <string name="ws_hint_arc_three_through">Bogen: einen Punkt antippen, durch den er läuft.</string>
    <string name="ws_hint_arc_tangent_start">Bogen: Ende einer Linie oder eines Bogens antippen – der Bogen setzt sie tangential fort.</string>
    <string name="ws_hint_arc_tangent_end">Bogen: Endpunkt antippen; weitere Tipps setzen den Zug tangential fort.</string>
    <string name="ws_hint_point">Punkt: Tippe, wo der Punkt liegen soll – auf einer Linie, einem Kreis oder einer Achse wird er dort gebunden.</string>
    <string name="ws_hint_trim">Trimmen: Tippe auf den Teil einer Linie, eines Kreises oder Bogens, der bis zu den nächsten Schnittpunkten wegfallen soll.</string>
    <string name="ws_hint_split">Teilen: Tippe auf eine Linie oder einen Bogen an der Stelle, an der sie geteilt werden sollen – einen Kreis teilt der Tipp in zwei Halbkreise.</string>
    <string name="ws_hint_extend">Verlängern: Tippe auf das Ende einer Linie oder eines Bogens – es reicht dann bis zum nächsten Element.</string>
    <string name="ws_hint_offset_element">Versatz: Tippe das Element an (bei Linien samt angrenzender Kette), dann die Seite.</string>
    <string name="ws_hint_offset_side">Versatz: Tippe jetzt auf die Seite, auf die der Versatz soll.</string>
    <string name="ws_hint_dimension">Bemaßen: Linie, Kreis oder Bogen antippen. Abstand oder Winkel: einen Punkt und ein zweites Element – zwei Linien: ohne Werkzeug beide antippen, dann „Abstand“ bzw. „Winkel“. Ins Leere tippen beendet.</string>
    <string name="ws_hint_corner_chamfer">Ecke fasen: Tippe auf die Ecke – den Punkt, an dem zwei Linien enden.</string>
    <string name="ws_hint_corner_fillet">Ecke runden: Tippe auf die Ecke – den Punkt, an dem zwei Linien enden.</string>
    <string name="ws_hint_mirror">Spiegeln: Tippe eine Linie als Achse an oder wähle die X- bzw. Y-Achse.</string>
    <string name="ws_hint_pattern_linear">Reihe: Tippe eine Linie als Richtung an – auf der Seite, in die die Reihe wachsen soll – oder wähle X bzw. Y.</string>
    <string name="ws_hint_pattern_circular">Kreismuster: Tippe einen Punkt oder Kreis als Mittelpunkt an oder nimm den Ursprung. 360° = voller Kreis.</string>
    <string name="ws_hint_transform">Transformieren: Bezugspunkt für Verschieben, Drehen oder Skalieren antippen.</string>

