    <!-- Hinweise zum aktiven Werkzeug -->
    <string name="ws_hint_select">Tap items or drag a box to select them. Dragging moves them – constraints are kept.</string>
    <string name="ws_hint_line">Line: tap points one after another (stylus: drag). “Done” or Esc ends the chain.</string>
    <string name="ws_hint_line_tangent">Tangent: tap start and end – one end on a circle or arc (or both: tangent between two circles).</string>
    <string name="ws_hint_rect_corners">Rectangle: tap or drag two opposite corners.</string>
    <string name="ws_hint_rect_center_first">Rectangle: tap the center first (e.g. the origin).</string>
    <string name="ws_hint_rect_center_corner">Rectangle: now tap a corner – the shape stays centered.</string>
    <string name="ws_hint_rect_three_start">Rectangle: tap the start of an edge.</string>
    <string name="ws_hint_rect_three_end">Rectangle: tap the end of the edge – angled is fine.</string>
    <string name="ws_hint_rect_three_height">Rectangle: now tap the height.</string>
    <string name="ws_hint_circle_center">Circle: center, then a point on the circle.</string>
    <string name="ws_hint_circle_two_points">Circle: tap two opposite points (diameter).</string>
    <string name="ws_hint_circle_three_points">Circle: tap three points on the circle (%1$d of 3).</string>
    <string name="ws_hint_circle_tangent2_pick">Circle: tap two lines, circles or arcs it should touch (%1$d of 2).</string>
    <string name="ws_hint_circle_tangent2_place">Circle: now tap the position – it sets the size.</string>
    <string name="ws_hint_circle_tangent3">Circle: tap three lines, circles or arcs it should touch (%1$d of 3) – near the touch point.</string>
    <string name="ws_hint_slot_first">Slot: tap the center of the first end.</string>
    <string name="ws_hint_slot_second">Slot: tap the center of the second end.</string>
    <string name="ws_hint_slot_width">Slot: now tap the width.</string>
    <string name="ws_hint_polygon_center">Polygon: tap the center.</string>
    <string name="ws_hint_polygon_inscribed_corner">Polygon: tap a corner (size and rotation).</string>
    <string name="ws_hint_polygon_circumscribed_side">Polygon: tap the middle of a side – the circle diameter is the across-flats width.</string>
    <string name="ws_hint_arc_center">Arc: center, start point, then the direction of the end (counterclockwise).</string>
    <string name="ws_hint_arc_three_start">Arc: tap the start point.</string>
    <string name="ws_hint_arc_three_end">Arc: tap the end point.</string>
    <string name="ws_hint_arc_three_through">Arc: tap a point it passes through.</string>
    <string name="ws_hint_arc_tangent_start">Arc: tap the end of a line or arc – the arc continues it tangentially.</string>
    <string name="ws_hint_arc_tangent_end">Arc: tap the end point; further taps continue the chain tangentially.</string>
    <string name="ws_hint_point">Point: tap where the point should go – on a line, circle or axis it snaps to that element.</string>
    <string name="ws_hint_text">Text: tap position to place text.</string>
    <string name="ws_hint_trim">Trim: tap the part of a line, circle or arc to remove, up to the nearest intersections.</string>
    <string name="ws_hint_split">Split: tap a line or arc where it should be split – tapping a circle splits it into two semicircles.</string>
    <string name="ws_hint_extend">Extend: tap the end of a line or arc – it then extends to the next element.</string>
    <string name="ws_hint_offset_element">Offset: tap the element (for lines, with its connected chain), then the side.</string>
    <string name="ws_hint_offset_side">Offset: now tap the side to offset to.</string>
    <string name="ws_hint_dimension">Dimension: tap a line, circle or arc. Distance or angle: a point and a second element – for two lines, tap both with no tool active, then “Distance” or “Angle”. Tap empty space to finish.</string>
    <string name="ws_hint_corner_chamfer">Chamfer corner: tap the corner – the point where two lines end.</string>
    <string name="ws_hint_corner_fillet">Fillet corner: tap the corner – the point where two lines end.</string>
    <string name="ws_hint_mirror">Mirror: tap a line as the axis or select the X or Y axis.</string>
    <string name="ws_hint_pattern_linear">Linear pattern: tap a line as the direction – on the side the pattern should grow – or select X or Y.</string>
    <string name="ws_hint_pattern_circular">Circular pattern: tap a point or circle as the center, or use the origin. 360° = full circle.</string>
    <string name="ws_hint_transform">Transform: tap the reference point for translation, rotation or scaling.</string>

